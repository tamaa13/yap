# 0G Chain RPC
ZG_MAINNET_RPC=https://evmrpc.0g.ai
ZG_TESTNET_RPC=https://evmrpc-testnet.0g.ai
ZG_MAINNET_CHAIN_ID=16661
ZG_TESTNET_CHAIN_ID=16602

# 0G Storage Indexer (Turbo mode)
ZG_MAINNET_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
ZG_TESTNET_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# Explorer
ZG_MAINNET_EXPLORER=https://chainscan.0g.ai
ZG_TESTNET_EXPLORER=https://chainscan-galileo.0g.ai

# Deployer wallet (DO NOT COMMIT)
# Generate via: cast wallet new
# Testnet faucet: https://faucet.0g.ai (0.1 OG/day)
PRIVATE_KEY=

# Deployed contract addresses (fill after deploy)
NEXT_PUBLIC_YAP_FIGHTER_ADDR_MAINNET=
NEXT_PUBLIC_YAP_FIGHTER_ADDR_TESTNET=
NEXT_PUBLIC_BATTLE_ESCROW_ADDR_MAINNET=
NEXT_PUBLIC_BATTLE_ESCROW_ADDR_TESTNET=
NEXT_PUBLIC_BATTLE_REGISTRY_ADDR_MAINNET=
NEXT_PUBLIC_BATTLE_REGISTRY_ADDR_TESTNET=

# Frontend network toggle (testnet | mainnet)
NEXT_PUBLIC_NETWORK=testnet

# 0G Compute Broker (for fine-tune + inference)
ZG_COMPUTE_LEDGER_DEPOSIT=3

# TEE Oracle (set after setup)
TEE_ORACLE_ADDR=
