# ─── 0G chain ────────────────────────────────────────────────
# Network toggle: `testnet` (Galileo, chainId 16602) or `mainnet` (Aristotle, 16661)
NEXT_PUBLIC_NETWORK=testnet

# ─── WalletConnect / RainbowKit ──────────────────────────────
# Register a free project at https://cloud.reown.com to get a projectId.
# Without one, WalletConnect-based wallets won't connect; MetaMask + injected
# wallets still work for local dev.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Deployed contract addresses ────────────────────────────
# Fill in after yap-contracts deploys.
NEXT_PUBLIC_YAP_FIGHTER_ADDR_MAINNET=
NEXT_PUBLIC_YAP_FIGHTER_ADDR_TESTNET=
NEXT_PUBLIC_BATTLE_ESCROW_ADDR_MAINNET=
NEXT_PUBLIC_BATTLE_ESCROW_ADDR_TESTNET=
NEXT_PUBLIC_BATTLE_REGISTRY_ADDR_MAINNET=
NEXT_PUBLIC_BATTLE_REGISTRY_ADDR_TESTNET=
# Phase 2 (CREATE2): MomentINFT collectibles, MomentMarketplace
# (second YapMarketplace instance pointed at MomentINFT), and the
# `<label>.yap.0g` permissionless registrar.
NEXT_PUBLIC_MOMENT_INFT_ADDR_MAINNET=
NEXT_PUBLIC_MOMENT_INFT_ADDR_TESTNET=
NEXT_PUBLIC_MOMENT_MARKET_ADDR_MAINNET=
NEXT_PUBLIC_MOMENT_MARKET_ADDR_TESTNET=
NEXT_PUBLIC_YAP_SUBNAME_ADDR_MAINNET=
NEXT_PUBLIC_YAP_SUBNAME_ADDR_TESTNET=

# ─── Server-only (0G SDK wrappers) ──────────────────────────
# Two service keys, isolated for blast-radius separation:
#   ZG_BROKER_KEY  — funds 0G Compute ledger + Storage submission gas.
#                    Leak only exposes Compute spend; can't forge verdicts.
#   ZG_RELAYER_KEY — submits verdicts on-chain via BattleEscrow.
#                    Holds minimal gas; verdict signature comes from the
#                    0G Compute provider's TEE enclave, so a leak here
#                    cannot forge verdicts or drain the Compute ledger.
ZG_BROKER_KEY=
ZG_RELAYER_KEY=
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZG_COMPUTE_LEDGER_DEPOSIT=3

# Pinned 0G Compute provider for the judge + verdict signing pipeline.
# MUST be the provider whose teeSignerAddress is registered as BattleEscrow's
# oracleKey on deploy. Random provider selection would break signature
# recovery on-chain. Query the 0G ServingContract for current providers.
ZG_INFERENCE_PROVIDER=

# ─── Battle state bus (Vercel deploy) ───────────────────────
# Vercel serverless can't share `globalThis` across function invocations,
# so battle state + event fan-out moves to Redis. Set EITHER pair below.
# Add the Vercel Marketplace > Redis integration to populate these
# automatically; or paste from your Upstash console.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy alias (Vercel KV / older marketplace integration):
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Verdict signing (0G Compute TEE provider) ──────────────
# Verdict signing happens INSIDE the 0G Compute provider's TeeML enclave —
# no separate signer service. The provider's TEE-derived ECDSA key is
# registered in the 0G ServingContract as `teeSignerAddress`; we set
# BattleEscrow.oracleKey to that address on deploy so the contract can
# verify the personal_sign over the canonical verdict text.
#
# No additional env vars needed for the signer path — the TEE binding is
# provided by ZG_INFERENCE_PROVIDER above + the on-chain oracleKey.

# ─── Live commentator (decorative ESPN-style color) ─────────
# Adds a 3rd inference call per round that streams 1-2 sentences of
# commentary on the round that just finished. Decorative only —
# never TEE-signed, never enters the verdict pipeline. Failures are
# tolerated (the battle proceeds normally if the commentator stalls
# or errors).
#
# Cost: ~+33% inference per round (~90 tokens per call). Pin a cheaper
# provider via ZG_COMMENTATOR_PROVIDER, otherwise the default chatbot
# provider used by fighter calls is reused.
#
# Default OFF so testnet ledger spend stays predictable. Flip to "true"
# when demoing or recording.
ZG_COMMENTATOR_ENABLED=false
ZG_COMMENTATOR_PROVIDER=
