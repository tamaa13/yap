# ─── 0G chain ────────────────────────────────────────────────
# Network toggle: `testnet` (Galileo, chainId 16602) or `mainnet` (Aristotle, 16661)
NEXT_PUBLIC_NETWORK=testnet

# ─── WalletConnect / RainbowKit ──────────────────────────────
# Register a free project at https://cloud.reown.com to get a projectId.
# Without one, WalletConnect-based wallets won't connect; MetaMask + injected
# wallets still work for local dev.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Deployed contract addresses ────────────────────────────
# Fill in after yap-contracts deploys.
NEXT_PUBLIC_YAP_FIGHTER_ADDR_MAINNET=
NEXT_PUBLIC_YAP_FIGHTER_ADDR_TESTNET=
NEXT_PUBLIC_BATTLE_ESCROW_ADDR_MAINNET=
NEXT_PUBLIC_BATTLE_ESCROW_ADDR_TESTNET=
NEXT_PUBLIC_BATTLE_REGISTRY_ADDR_MAINNET=
NEXT_PUBLIC_BATTLE_REGISTRY_ADDR_TESTNET=

# ─── Server-only (0G SDK wrappers) ──────────────────────────
# Wallet funding for storage uploads + compute broker. Never committed.
ZG_SERVER_PRIVATE_KEY=
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZG_COMPUTE_LEDGER_DEPOSIT=3

# ─── TEE oracle ─────────────────────────────────────────────
TEE_ORACLE_ADDR=
