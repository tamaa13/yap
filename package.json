{
  "name": "yap",
  "version": "0.1.0",
  "private": true,
  "description": "Yap — verifiable AI combat arena. Built on 0G.",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev": "pnpm -F web dev",
    "build": "pnpm -F web build",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vvv",
    "contracts:deploy:testnet": "cd contracts && forge script script/Deploy.s.sol --rpc-url $ZG_TESTNET_RPC --broadcast --private-key $PRIVATE_KEY",
    "contracts:deploy:mainnet": "cd contracts && forge script script/Deploy.s.sol --rpc-url $ZG_MAINNET_RPC --broadcast --private-key $PRIVATE_KEY",
    "contracts:deploy:v3:testnet": "cd contracts && forge script script/DeployV2Ceremony.s.sol:DeployV2Ceremony --rpc-url $ZG_TESTNET_RPC --broadcast --legacy --priority-gas-price 2000000000 --evm-version cancun --private-key $PRIVATE_KEY",
    "contracts:deploy:v3:mainnet": "cd contracts && forge script script/DeployV2Ceremony.s.sol:DeployV2Ceremony --rpc-url $ZG_MAINNET_RPC --broadcast --legacy --priority-gas-price 2000000000 --evm-version cancun --private-key $PRIVATE_KEY",
    "contracts:sync-abi": "scripts/sync-abi.sh"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "patchedDependencies": {
      "@0gfoundation/0g-ts-sdk@1.2.6": "patches/@0gfoundation__0g-ts-sdk@1.2.6.patch"
    }
  }
}
